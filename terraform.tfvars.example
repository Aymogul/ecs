region             = "us-east-1"
env                = "staging"
vpc_cidr           = "10.0.0.0/16"
public_subnets     = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnets    = ["10.0.11.0/24", "10.0.12.0/24"]
availability_zones = ["us-east-1a", "us-east-1b"]

app_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/staging-aster-app@sha256:replace-me"

# Create a Temporal Cloud namespace first. Do not commit its API key.
temporal_cloud_address   = "your-namespace.your-account.tmprl.cloud:7233"
temporal_cloud_namespace = "your-namespace"
temporal_cloud_api_key   = "set-through-TF_VAR_temporal_cloud_api_key-in-CI"

# Keep staging inexpensive. Production should enable Multi-AZ and deletion protection.
database_multi_az            = false
database_deletion_protection = false
database_skip_final_snapshot = true
